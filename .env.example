# Provided by the Supabase integration on Vercel (`vercel integration add supabase`, then `vercel env pull`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Resume parsing. With a Gemini key (Google AI Studio) set, Gemini is called directly.
GOOGLE_GENERATIVE_AI_API_KEY=
# Without one the call goes through the Vercel AI Gateway: on Vercel the OIDC token is used
# automatically; locally `vercel env pull` provides VERCEL_OIDC_TOKEN.
# AI_GATEWAY_API_KEY=

# Used for email confirmation links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Java code challenges run in a Vercel Sandbox booted from this snapshot.
# Make it once with: node --env-file=.env.local scripts/java-sandbox.mjs
JAVA_SANDBOX_SNAPSHOT=
